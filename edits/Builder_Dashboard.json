            {
              "id": "Text1",
              "type": "StaticText",
              "text": "School / Okul"
            },
            {
              "id": "Counter_School",
              "type": "DataWidget",
              "dataSourceType": "variable",
              "variableName": "schoolCount",
              "format": "integer"
            }
          ]
        },
        {
          "id": "Container_Course",
          "type": "DivContainer",
          "class": "dashboard-card",
          "onClick": "open page Builder.Course_Overview()",
