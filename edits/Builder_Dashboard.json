                  "desktop": 4,
                  "tablet": 6,
                  "phone": 12
                },
                {
                  "widget": "ActionButton14",
                  "desktop": 4,
                  "tablet": 6,
                  "phone": 12
                }
              ]
            },
            {
              "size": "auto",
              "cells": [
                {
                  "widget": "Container_School",
                  "desktop": 4,
                  "tablet": 6,
                  "phone": 12
                },
                {
                  "widget": "Container_Course",
                  "desktop": 4,
                  "tablet": 6,
                  "phone": 12
                },
                {
                  "widget": "Container_Lecture",
