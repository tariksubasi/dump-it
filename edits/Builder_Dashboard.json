            {
              "id": "Text2",
              "type": "StaticText",
              "text": "Course / Kurs"
            },
            {
              "id": "Counter_Course",
              "type": "DataWidget",
              "dataSourceType": "variable",
              "variableName": "courseCount",
              "format": "integer"
